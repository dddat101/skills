# ==============================================================================
# NETWORK TEST LAB - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Topology & Role Selection
# 'single': 1 PC with 2 USB NICs connected to DUT WAN & LAN (Recommended)
# 'wan':    PC1 acting as WAN Gateway / Server
# 'lan':    PC2 acting as LAN Client
LAB_ROLE="single"
TOPOLOGY_MODE="virtual"    # 'physical' or 'virtual'

# 2. Physical Interfaces (MUST NOT carry host default route!)
WAN_IF="enxd46e0e0c65e1"
LAN_IF="enx00e04c88293c"
TEST_IF="enxd46e0e0c65e1"   # For 2-PC distributed mode

# 3. IP Subnet Configurations
WAN_SERVER_IP="10.10.0.10"
WAN_PREFIX="24"
DUT_WAN_IP="10.10.0.1"

DUT_LAN_IP="192.168.1.1"
LAN_PREFIX="24"
LAN_CLIENT_IP="192.168.1.100"

# 4. Bridge & Namespace Names
WAN_BRIDGE="br-test-wan"
LAN_BRIDGE="br-test-lan"
WAN_NS="ns-wan"
LAN_NS="ns-lan"
DUT_NS="ns-dut"

# 5. Packet Capture Settings (Strict double-quoting required)
CAPTURE_FILTER="(udp port 67 or udp port 68) or arp or icmp"
CAPTURE_DIR="captures"
LOG_DIR="logs"
STATE_DIR="state"

# 6. Binary Paths (Empty auto-detects .venv/bin/python3)
TCPDUMP_BIN="tcpdump"
TSHARK_BIN="tshark"
PYTHON_BIN=""

# 7. Physical Interface Restoration
# 1 = Restore NICs to UP + re-enable NetworkManager + DHCP on cleanup
# 0 = Leave interfaces DOWN and flushed (isolated test mode)
RESTORE_INTERFACES_ON_CLEANUP="1"

# 8. DUT Remote Management via SSH (Optional)
DUT_SSH_HOST=""
DUT_SSH_PORT="22"
DUT_SSH_USER="root"
DUT_SSH_KEY=""
