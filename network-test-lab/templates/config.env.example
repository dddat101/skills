# ==============================================================================
# GATEWAY PERFORMANCE LAB - ENVIRONMENT CONFIGURATION
# Standard: Wire-rate Throughput, Rate-Mismatch Burst Absorption, QoS Isolation
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Topology & Execution Mode
# ------------------------------------------------------------------------------
# TOPOLOGY_MODE:
#   'virtual'  : Full software simulation using isolated Linux netns (ns-wan, ns-dut, ns-pc, ns-stb, ns-wlan*)
#   'physical' : Physical testbed using dedicated NICs connected to external hardware DUT
TOPOLOGY_MODE="virtual"
LAB_ROLE="single"
IP_VERSION="dual"

# ------------------------------------------------------------------------------
# 2. Physical Adapters (Used when TOPOLOGY_MODE="physical")
# ------------------------------------------------------------------------------
# In Physical mode, connect PC test NICs to physical DUT ports:
#   WAN_IF : Connects to DUT WAN port (e.g. eth0)
#   LAN_IF / PC_IF : Connects to DUT 1G LAN PC port (e.g. eth3)
#   STB_IF : Connects to DUT 100M IPTV STB port (e.g. eth1)
WAN_IF="enxd46e0e0c65e1"
LAN_IF="enx00e04c88293c"
PC_IF="enx00e04c88293c"
STB_IF=""

# Optional dedicated physical Wi-Fi adapters / USB dongles (for physical multi-station testbed)
WLAN2G_IF=""
WLAN5G_IF=""
WLAN6G_IF=""
PHONE1_IF=""
PHONE2_IF=""

# Optional 802.1Q VLAN Trunk Mode (when using managed switch trunk port connected to 1 PC NIC)
# If configured, sub-interfaces are automatically created (e.g. ${VLAN_TRUNK_IF}.10 for PC, .20 for STB)
VLAN_TRUNK_IF=""
VLAN_ID_PC="10"
VLAN_ID_STB="20"
VLAN_ID_WLAN2G="31"
VLAN_ID_WLAN5G="32"
VLAN_ID_WLAN6G="33"

RESTORE_INTERFACES_ON_CLEANUP="1"

# ------------------------------------------------------------------------------
# 3. Network Namespace Names
# ------------------------------------------------------------------------------
WAN_NS="ns-wan"
DUT_NS="ns-dut"
PC_NS="ns-pc"
STB_NS="ns-stb"
WLAN2G_NS="ns-wlan2g"
WLAN5G_NS="ns-wlan5g"
WLAN6G_NS="ns-wlan6g"
PHONE1_NS="ns-phone1"
PHONE2_NS="ns-phone2"

# ------------------------------------------------------------------------------
# 4. Upstream WAN Network Parameters (RFC 5737 Official Public Test-Net)
# ------------------------------------------------------------------------------
# Official Public Test-Net 3 (RFC 5737): 203.0.113.0/24
WAN_BRIDGE="br-test-wan"
WAN_SERVER_IP="203.0.113.1"
DUT_WAN_IP="203.0.113.129"
WAN_PREFIX="24"
WAN_GATEWAY="203.0.113.1"
WAN_IPV6_CIDR="2001:db8:10::1/64"
DUT_WAN_IPV6="2001:db8:10::2/64"

# 802.1Q VLAN Tagging for WAN Port (e.g. tagged WAN sub-interface with VID 1)
# Set to "1" when connecting to physical WAN port requiring 802.1Q VID 1, or empty if untagged
WAN_VLAN_ID="1"

# Enable WAN DHCP Server in ns-wan (Automatically leases IP to DUT WAN)
WAN_DHCP_ENABLE="1"
WAN_DHCP_BACKEND="auto"           # Options: "auto" (Kea with dnsmasq fallback), "kea", "dnsmasq"
WAN_DHCP_RANGE_START="203.0.113.100"
WAN_DHCP_RANGE_END="203.0.113.200"

# ------------------------------------------------------------------------------
# 5. LAN Network & Client Subnets
# ------------------------------------------------------------------------------
DUT_LAN_IP="192.168.1.1"
DUT_LAN_IPV6="2001:db8:100::1"
LAN_PREFIX="24"

# Enable dynamic DHCP client on LAN endpoints (leases IP from DUT LAN br0)
# Default is "1" in --single mode to automatically acquire IPv4 & IPv6 from DUT
LAN_DHCP_CLIENT="1"

# Client IP Assignments
PC_IP="192.168.1.10"
STB_IP="192.168.1.20"
WLAN2G_IP="192.168.1.31"
WLAN5G_IP="192.168.1.32"
WLAN6G_IP="192.168.1.33"
PHONE1_IP="192.168.1.41"
PHONE2_IP="192.168.1.42"

# ------------------------------------------------------------------------------
# 6. Rate Mismatch & Burst Emulation (1 Gbps WAN -> 100 Mbps LAN STB)
# ------------------------------------------------------------------------------
# Gateway Uplink & Wired PC Port (1 Gbps Giga Gateway)
WAN_RATE_LIMIT="1000mbit"
WAN_BURST_BUFFER="512kb"
PC_RATE_LIMIT="1000mbit"
PC_BURST_BUFFER="512kb"

# Simulated 100BASE-TX Fast Ethernet link bottleneck
STB_RATE_LIMIT="100mbit"
STB_QUEUE_BURST_BUFFER="512kb"
STB_QUEUE_LIMIT="4mb"

# Burst Test Case 1: 1500B packets, Burst Load 50%, Burst Length >= 53 frames
BURST_CASE1_FRAMES="53"
BURST_CASE1_LOAD="50.0"

# Burst Test Case 2: 1500B packets, Burst Length 100 frames, Burst Load >= 16%
BURST_CASE2_FRAMES="100"
BURST_CASE2_LOAD="16.0"

BURST_PACKET_SIZE="1500"
BURST_COUNT="20"

# ------------------------------------------------------------------------------
# 7. Wire-Rate & QoS Verification Thresholds
# ------------------------------------------------------------------------------
# Wire-Rate 1024B Unicast Engine:
#   'auto'   : Prefer iperf3 (C-based kernel performance) if installed, fallback to Python
#   'iperf3' : Use iperf3 -u -b 1000M -l 982 for maximum wire-rate accuracy (>116,000 PPS)
#   'python' : Use native zero-allocation Python traffic_generator.py
WIRE_RATE_ENGINE="auto"

UNICAST_PACKET_SIZE="1024"
MULTICAST_PACKET_SIZE="1024"
MULTICAST_GROUP="239.255.0.1"

# Maximum allowable performance degradation (Percentage)
THROUGHPUT_DROP_TOLERANCE_PCT="1.0"
VOIP_IMPACT_TOLERANCE_PCT="1.0"

# Cloud Gaming (GeForce NOW) Acceptance Criteria
GEFORCE_NOW_MAX_LOSS_PCT="0.0"
GEFORCE_NOW_MAX_JITTER_MS="2.0"
GEFORCE_NOW_BITRATE_MBPS="25.0"
GEFORCE_NOW_FPS="60"

# UHD+Dolby 1.2x VOD Parameters
VOD_BASE_BITRATE_MBPS="35.0"
VOD_SPEED_MULTIPLIER="1.2"

# Benchmark Parameters
BENCHMARK_TRIALS="5"
BENCHMARK_DURATION_SEC="5"

# ------------------------------------------------------------------------------
# 8. Runtime Storage & Binaries
# ------------------------------------------------------------------------------
CAPTURE_DIR="captures"
LOG_DIR="logs"
STATE_DIR="state"
TCPDUMP_BIN="tcpdump"
TSHARK_BIN="tshark"
PYTHON_BIN="python3"
IPERF3_BIN="iperf3"
CAPTURE_FILTER="udp or tcp or icmp or arp"
