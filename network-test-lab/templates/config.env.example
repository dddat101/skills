# ==============================================================================
# NETWORK TEST LAB - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Topology & Role Selection
# 'single': 1 PC with 2 USB NICs connected to DUT WAN & LAN (Recommended)
# 'wan':    PC1 acting as WAN Gateway / Server
# 'lan':    PC2 acting as LAN Client
LAB_ROLE="single"
TOPOLOGY_MODE="virtual"    # 'physical' or 'virtual'
IP_VERSION="dual"          # "4" (IPv4), "6" (IPv6), or "dual" (Dual-Stack)

# 2. Physical Interfaces (MUST NOT carry host default route!)
WAN_IF="enxd46e0e0c65e1"
LAN_IF="enx00e04c88293c"
TEST_IF="enxd46e0e0c65e1"   # For 2-PC distributed mode

# 3. Linux Bridge & Network Namespace Names
WAN_BRIDGE="br-test-wan"
LAN_BRIDGE="br-test-lan"
WAN_NS="ns-wan"
LAN_NS="ns-lan"
DUT_NS="ns-dut"
NS_IF="eth0"

# ------------------------------------------------------------------------------
# 4. Upstream WAN IPv4 & Server Backend Parameters (Mandatory Dual-Stack)
# ------------------------------------------------------------------------------
# WAN always provisions both DHCPv4 and DHCPv6 concurrently by default.
ENABLE_WAN_DHCP="1"
WAN_DHCP_BACKEND="kea"      # 'kea' (Kea Triad Standard: kea-dhcp4 + kea-dhcp6 + radvd), or 'dnsmasq' (fallback)
WAN_IPV4_CIDR="10.10.0.1/24"
WAN_IPV4_SUBNET="10.10.0.0/24"
WAN_IPV4_POOL_START="10.10.0.100"
WAN_IPV4_POOL_END="10.10.0.200"
WAN_IPV4_ROUTER="10.10.0.1"
WAN_IPV4_DNS="10.10.0.1"
WAN_IPV4_DNS2="10.10.0.2"
WAN_DHCP_LEASE="12h"

# ------------------------------------------------------------------------------
# 5. Upstream WAN IPv6 & DHCPv6 Modes (Comprehensive RFC Standards)
# ------------------------------------------------------------------------------
# Supported WAN IPv6 Modes:
#   'dual-stack' : (Default) Concurrent DHCPv4 + DHCPv6 IA_NA + IA_PD + SLAAC (M=1, O=1, A=1)
#   'slaac'      : Stateless Address Autoconfiguration (RFC 4862) + RDNSS (RFC 8106) (M=0, O=0, A=1)
#   'stateless'  : SLAAC addressing + DHCPv6 Information-Request for DNS/NTP/AFTR (M=0, O=1, A=1)
#   'stateful'   : Stateful DHCPv6 address only (RFC 8415 IA_NA, M=1, O=1, A=0)
#   'stateful-pd': Stateful DHCPv6 address (IA_NA) + Prefix Delegation (IA_PD RFC 3633/8415)
#   'pd-only'    : SLAAC WAN addressing + DHCPv6 Prefix Delegation (IA_PD) for LAN
#   'ds-lite'    : Dual-Stack Lite (RFC 6333) with DHCPv6 Option 64 (AFTR FQDN)
WAN_IPV6_MODE="dual-stack"

WAN_IPV6_CIDR="2001:db8:10::1/64"
WAN_IPV6_PREFIX="2001:db8:10::/64"
WAN_IPV6_POOL_START="2001:db8:10::1000"
WAN_IPV6_POOL_END="2001:db8:10::1fff"
WAN_IPV6_DNS="2001:db8:10::1"
WAN_IPV6_DNS2="2001:db8:10::2"

# Router Advertisement (RA) Flags: (Empty = Auto-derived from WAN_IPV6_MODE)
# Values: 'on' or 'off'
RA_MANAGED_FLAG=""        # M-flag: Stateful DHCPv6 for addresses (IA_NA)
RA_OTHER_CONFIG_FLAG=""    # O-flag: DHCPv6 for other configuration (DNS, AFTR)
RA_AUTONOMOUS_FLAG=""      # A-flag: SLAAC address autoconfiguration

# Prefix Delegation (DHCPv6-PD - RFC 3633 / RFC 8415)
PD_PREFIX="2001:db8:100::"
PD_PREFIX_LEN="56"
PD_DELEGATED_LEN="60"

# ------------------------------------------------------------------------------
# 6. DS-Lite (Dual-Stack Lite - RFC 6333) & AFTR Parameters
# ------------------------------------------------------------------------------
AFTR_IPV6="2001:db8:10::affe"
AFTR_NAME="aftr.example.com"

# ------------------------------------------------------------------------------
# 7. LAN Subnet & Client Defaults
# ------------------------------------------------------------------------------
DUT_LAN_IP="192.168.1.1"
DUT_LAN_IPV6="2001:db8:100::1"
LAN_IPV4_SUBNET="192.168.1.0/24"
LAN_IPV6_PREFIX="2001:db8:100::/64"
LAN_CLIENT_IPV4="192.168.1.100"
LAN_CLIENT_IPV6="2001:db8:100::100"
LAN_CLIENT_HOSTNAME="ipv6-stb-client"
LAN_CLIENT_VENDOR="IPTV_STB"

# ------------------------------------------------------------------------------
# 8. Router Advertisement (RA) Timers & DHCP Lifetimes
# ------------------------------------------------------------------------------
RA_MIN_INTERVAL_SEC="3"
RA_MAX_INTERVAL_SEC="10"
RA_LIFETIME_SEC="60"
DHCP_VALID_LIFETIME_SEC="600"
DHCP_RENEW_TIMER_SEC="300"
DHCP_REBIND_TIMER_SEC="450"

# ------------------------------------------------------------------------------
# 9. Packet Capture & Runtime Settings (Strict double-quoting required)
# ------------------------------------------------------------------------------
CAPTURE_FILTER="(udp port 67 or udp port 68) or (udp port 546 or udp port 547) or icmp6 or arp or icmp"
CAPTURE_DIR="captures"
LOG_DIR="logs"
STATE_DIR="state"

# 10. Binary Paths (Empty auto-detects .venv/bin/python3)
TCPDUMP_BIN="tcpdump"
TSHARK_BIN="tshark"
PYTHON_BIN=""

# 11. Physical Interface Restoration
# 1 = Restore NICs to UP + re-enable NetworkManager + DHCP on cleanup
# 0 = Leave interfaces DOWN and flushed (isolated test mode)
RESTORE_INTERFACES_ON_CLEANUP="1"

# 12. DUT Remote Management via SSH (Optional)
DUT_SSH_HOST=""
DUT_SSH_PORT="22"
DUT_SSH_USER="root"
DUT_SSH_KEY=""
